{
  "id": "rental_condition",
  "title": "Rental condition",
  "subtitle": "Room by room, move-in vs move-out",
  "keywords": [
    "rental",
    "apartment",
    "lease",
    "landlord",
    "tenant",
    "deposit",
    "move in",
    "move out",
    "inspection"
  ],
  "surfaceId": "report",
  "slots": [
    {
      "id": "inspection",
      "type": "choice",
      "hint": "Move-in or move-out inspection",
      "choices": [
        "move_in",
        "move_out"
      ]
    },
    {
      "id": "room",
      "type": "choice",
      "hint": "Room shown in the photos",
      "choices": [
        "kitchen",
        "bathroom",
        "bedroom",
        "living_room"
      ]
    },
    {
      "id": "condition",
      "type": "choice",
      "hint": "Overall condition",
      "choices": [
        "good",
        "fair",
        "damaged"
      ]
    },
    {
      "id": "room_notes",
      "type": "text",
      "hint": "Marks, wear or damage per room",
      "maxLength": 400
    },
    {
      "id": "summary",
      "type": "text",
      "hint": "Neutral first-person summary of the inspection",
      "maxLength": 600
    },
    {
      "id": "ev_entry_wide",
      "type": "flag",
      "hint": "True when the evidence photos already cover this"
    },
    {
      "id": "ev_floors",
      "type": "flag",
      "hint": "True when the evidence photos already cover this"
    },
    {
      "id": "ev_walls",
