type Allow = variant {
  key : record { key_id : blob; pubkey : blob };
  revoke : blob;
  "record" : record { key_id : blob; record_id : text };
};
type BeginUpload = record {
  signature : blob;
  sha256 : blob;
  key_id : blob;
  size : nat64;
  target : UploadTarget;
  grant : opt EntitlementGrant;
};
type Begun = record { missing : vec nat32; upload : nat64 };
type CaseInfo = record { bytes : nat64; chunks : nat32; expires_ns : nat64 };
type Chunk = record { ix : nat32; upload : nat64; bytes : blob };
type EntitlementGrant = record {
  signature : blob;
  ii_principal : principal;
  tier : Tier;
  quota_bytes : nat64;
  expires_ns : nat64;
};
// A Candid-encodable representation of an HTTP request. This struct is used by
// the `http_request` method of the HTTP Gateway Protocol's Candid interface.
// 
// # Examples
// 
// ```
// use ic_http_certification::{HttpRequest, Method};
// 
// let request = HttpRequest::builder()
// .with_method(Method::GET)
// .with_url("/")
// .with_headers(vec![("X-Custom-Foo".into(), "Bar".into())])
// .with_body(&[1, 2, 3])
// .with_certificate_version(2)
// .build();
// 
// assert_eq!(request.method(), Method::GET);
// assert_eq!(request.url(), "/");
// assert_eq!(request.headers(), &[("X-Custom-Foo".into(), "Bar".into())]);
// assert_eq!(request.body(), &[1, 2, 3]);
// assert_eq!(request.certificate_version(), Some(2));
// ```
// 
// # Helpers
// 
// There are also a number of convenience methods for quickly creating an [HttpRequest] with
// commonly used HTTP methods:
// 
// - [GET](HttpRequest::get)
// - [POST](HttpRequest::post)
// - [PUT](HttpRequest::put)
// - [PATCH](HttpRequest::patch)
// - [DELETE](HttpRequest::delete)
// 
// ```
// use ic_http_certification::HttpRequest;
// 
// let request = HttpRequest::get("/").build();
// 
// assert_eq!(request.method(), "GET");
// assert_eq!(request.url(), "/");
// ```
type HttpRequest = record {
  // HTTP request URL.
  url : text;
  // HTTP request method.
  method : text;
  // HTTP request body as an array of bytes.
  body : blob;
  // HTTP request headers.
  headers : vec record { text; text };
  // The max response verification version to use in the response's
  // certificate.
  certificate_version : opt nat16;
};
type HttpResponse = record {
  body : blob;
  headers : vec record { text; text };
  upgrade : opt bool;
  streaming_strategy : opt StreamingStrategy;
  status_code : nat16;
};
type MediaErr = variant {
  incomplete;
  malformed : text;
  not_found;
  retry_after_ns : nat64;
  unauthorized;
  too_large;
  grant_invalid;
  quota_exceeded;
  bad_chunk;
  hash_mismatch;
};
type Origins = record {
  api : text;
  app : text;
  case : text;
  site : text;
  canister : text;
};
type PeerInit = record {
  origins : opt Origins;
  shard : nat8;
  registry : principal;
};
type Result = variant { Ok : Begun; Err : MediaErr };
type Result_1 = variant { Ok : text; Err : MediaErr };
type Result_2 = variant { Ok : nat32; Err : MediaErr };
type Result_3 = variant { Ok; Err : MediaErr };
type Status = record {
  flags : vec text;
  timers : vec TimerStatus;
  metrics : vec record { text; nat64 };
  version : text;
  cycles : nat;
  stable_bytes : nat64;
};
type StreamingCallbackHttpResponse = record {
  token : opt StreamingToken;
  body : blob;
};
type StreamingStrategy = variant {
  Callback : record {
    token : StreamingToken;
    callback : func (StreamingToken) -> (StreamingCallbackHttpResponse) query;
  };
};
type StreamingToken = record { "blob" : nat64; offset : nat64 };
type Tier = variant { Plus };
type TimerStatus = record {
  name : text;
  runs : nat64;
  period_ns : nat64;
  last_run_ns : nat64;
};
type UploadTarget = variant {
  og : text;
  preview : text;
  full : text;
  case_chunk : record { ix : nat32; count : nat32; case_id : text };
};
service : (PeerInit) -> {
  begin_upload : (BeginUpload) -> (Result);
  case_info : (text) -> (opt CaseInfo) query;
  checks : (vec text) -> (vec nat64) query;
  commit : (nat64) -> (Result_1);
  count_checks : (vec text) -> (nat32);
  erase : (text) -> (Result_2);
  http_request : (HttpRequest) -> (HttpResponse) query;
  http_request_streaming_callback : (StreamingToken) -> (
      StreamingCallbackHttpResponse,
    ) query;
  put_chunk : (Chunk) -> (Result_3);
  status : () -> (Status) query;
  sync : (vec Allow) -> (nat32);
}
